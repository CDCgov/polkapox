/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

process {
    // override base.config default so test failures are not silently ignored
    errorStrategy = 'terminate'
    memory = { [task.memory, 12.GB].min() }
    withName: VCFTOOLS_DIFF_RUN {
        ext.args = '--diff --diff-site'
    }
    withName: BWA_DENOVO {
        cpus = Math.min(4, Runtime.getRuntime().availableProcessors())
    }

    withName: BWA_INDEX {
        cpus = Math.min(4, Runtime.getRuntime().availableProcessors())
    }

    withName: BWA_MEM {
        cpus = Math.min(4, Runtime.getRuntime().availableProcessors())
    }

    withName: UNICYCLER {
        cpus = Math.min(4, Runtime.getRuntime().availableProcessors())
    }

    withName: KRAKEN2 {
        cpus = Math.min(4, Runtime.getRuntime().availableProcessors())
    }    
}
