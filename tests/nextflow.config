/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

process {
    // override base.config default so test failures are not silently ignored
    errorStrategy = 'terminate'
    memory = 6.GB
    cpus   = 2
    // BWA_INDEX sizes memory as 7 B per fasta byte (~1.4 MB for the test genome), which is
    // below Docker's 6 MB minimum container memory and fails under --profile docker
    withName: BWA_INDEX {
        memory = 6.GB
    }
    withName: VCFTOOLS_DIFF_RUN {
        ext.args = '--diff --diff-site'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_high' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_high_memory' {
        cpus   = 2
        memory = 6.GB
    }
}

params {
    max_cpus   = 2
    max_memory = 6.GB
}
