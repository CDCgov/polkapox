nextflow_workflow {

    name "Test Workflow IVAR_CONSENSUS_POLISH"
    script "subworkflows/local/ivar_consensus_polish.nf"
    workflow "IVAR_CONSENSUS_POLISH"

    test("Should run without failures") {

        when {
            params {
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test_sub' ],
                    file("${projectDir}/tests/nf-test-data/test_sub.bam", checkIfExists: true),
                    file("${projectDir}/tests/nf-test-data/test_sub.assembly_asm.fasta", checkIfExists: true)
                ])
                input[1] = false
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
