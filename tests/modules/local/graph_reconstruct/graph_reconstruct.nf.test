nextflow_process {

    name "Test Process GRAPH_RECON"
    script "modules/local/graph_reconstruct/graph_reconstruct.nf"
    process "GRAPH_RECON"

    // -----------------------------------------------------------------------
    // Clade II — standard graph (2 ITRs + single copy region)
    // -----------------------------------------------------------------------
    test("Clade II standard GFA - should PASS and produce assembly FASTA") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeII_standard', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeII_standard.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            // Assembly FASTA and contig FASTA must be produced
            assert process.out.gfa_assembly.size()    == 1
            assert process.out.unicycler_contigs.size() == 1
            // Log must be written
            assert process.out.log.size() == 1
            // Assembly FASTA must be non-empty
            def asmFasta = process.out.gfa_assembly[0][1]
            assert path(asmFasta).text.contains('>')
            // Log must record PASS status
            def logJson = new groovy.json.JsonSlurper().parseText(path(process.out.log[0]).text)
            def lastKey = logJson.keySet().sort().last()
            assert logJson[lastKey]['status'].startsWith('PASS')
        }

    }

    // -----------------------------------------------------------------------
    // Clade I — classic DRC graph
    // -----------------------------------------------------------------------
    test("Clade I standard GFA - should PASS and produce assembly FASTA") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeI_standard', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeI_standard.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert process.out.gfa_assembly.size()    == 1
            assert process.out.unicycler_contigs.size() == 1
            assert process.out.log.size() == 1
            def asmFasta = process.out.gfa_assembly[0][1]
            assert path(asmFasta).text.contains('>')
            def logJson = new groovy.json.JsonSlurper().parseText(path(process.out.log[0]).text)
            def lastKey = logJson.keySet().sort().last()
            assert logJson[lastKey]['status'].startsWith('PASS')
        }

    }

    // -----------------------------------------------------------------------
    // Clade II — single-ITR graph (legitimate edge case)
    // -----------------------------------------------------------------------
    test("Clade II single-ITR GFA - should PASS") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeII_one_itr', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeII_one_itr.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert process.out.log.size() == 1
            def logJson = new groovy.json.JsonSlurper().parseText(path(process.out.log[0]).text)
            def lastKey = logJson.keySet().sort().last()
            assert logJson[lastKey]['status'].startsWith('PASS')
        }

    }

    // -----------------------------------------------------------------------
    // Clade II — broken/incomplete graph (FAIL expected)
    // -----------------------------------------------------------------------
    test("Clade II broken GFA - process should FAIL with non-zero exit code") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeII_broken', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeII_broken.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            // Broken assemblies must produce a non-zero exit.
            // Nextflow does not stage outputs from failed processes, so we can
            // only assert on process.success here; log content is validated by
            // the pytest unit tests in tests/test_assembly_graph.py.
            assert !process.success
        }

    }

    // -----------------------------------------------------------------------
    // Clade I — broken graph (FAIL expected)
    // -----------------------------------------------------------------------
    test("Clade I broken GFA - process should FAIL with non-zero exit code") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeI_broken', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeI_broken.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert !process.success
        }

    }

    // -----------------------------------------------------------------------
    // Clade II — recombinant (complex graph, FAIL expected)
    // -----------------------------------------------------------------------
    test("Clade II recombinant GFA - process should FAIL") {

        when {
            params {}
            process {
                """
                input[0] = Channel.of([
                    [ id: 'cladeII_recombinant', single_end: true ],
                    file('${projectDir}/tests/nf-test-data/cladeII_recombinant.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert !process.success
        }

    }

}
