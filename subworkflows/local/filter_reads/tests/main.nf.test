nextflow_workflow {

    name "Test Workflow READ_FILTER"
    script "../main.nf"
    workflow "READ_FILTER"

    test("Pair-end reads") {

        when {
            params {
                kraken_db = "s3://io-pe1-prod-ncezid-oamd-nextstrain/polkapox/orthopox_t2t_kdb/"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'sample1', single_end: false ],
                    [
                        file("${projectDir}/tests/nf-test-data/test_sub.classified_1.fastq.gz", checkIfExists: true),
                        file("${projectDir}/tests/nf-test-data/test_sub.classified_2.fastq.gz", checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
