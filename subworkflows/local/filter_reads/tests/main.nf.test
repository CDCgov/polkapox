nextflow_workflow {

    name "Test Workflow READ_FILTER"
    script "../main.nf"
    workflow "READ_FILTER"

    test("Paired-end reads") {

        when {
            params {
                kraken_db = "s3://io-pe1-prod-ncezid-oamd-nextstrain/polkapox/orthopox_t2t_kdb/"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'sample1', single_end: false ],
                    [
                        file("s3://io-pe1-prod-ncezid-oamd-nextstrain/polkapox/test_data/test_sub_1.fq.gz"),
                        file("s3://io-pe1-prod-ncezid-oamd-nextstrain/polkapox/test_data/test_sub_2.fq.gz")
                    ]
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.versions.size() >= 1
            assert snapshot(
                workflow.out.trimmed_fastq,
                workflow.out.json,
                workflow.out.kraken2_report,
                workflow.out.classified_reads_assignment,
                workflow.out.seqtk_reads
            ).match()
        }

    }

}
