nextflow_workflow {

    name "Test subworkflow SAMTOOLS_FLAGSTAT_DENOVO"
    script "../main.nf"
    workflow "SAMTOOLS_FLAGSTAT_DENOVO"

    test("Should run without failures") {

        when {
            params {
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test_sub' ],
                    file("${projectDir}/tests/nf-test-data/test_sub.bam", checkIfExists: true),
                    file("${projectDir}/tests/nf-test-data/test_sub.bam.bai", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
