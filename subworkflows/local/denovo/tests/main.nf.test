nextflow_workflow {

    name "Test Subworkflow DENOVO"
    script "../main.nf"
    workflow "DENOVO"

    test("Should run without failures") {

        when {
            params {
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'test_sub' ],
                    file("${projectDir}/assets/NC_003310_clade_I.fasta", checkIfExists: true),
                    [
                        file("${moduleTestDir}/test_sub_1.fastp.fastq.gz", checkIfExists: true),
                        file("${moduleTestDir}/test_sub_2.fastp.fastq.gz", checkIfExists: true)
                    ]
                ])
                input[1] = true
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
