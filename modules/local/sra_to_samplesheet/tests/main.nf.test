nextflow_process {

    name "Test Process SRA_TO_SAMPLESHEET"
    script "../main.nf"
    process "SRA_TO_SAMPLESHEET"

    test("Create samplesheet from SRA") {

        when {
            params {
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [meta: "test_sub",  fastq1: file("${moduleTestDir}/test_sub_1.fq.gz")]
                input[1] = [meta: "test_sub",  fastq2: file("${moduleTestDir}/test_sub_2.fq.gz")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.samplesheet).match()
        }

    }

}
