nextflow_process {

    name "Test Process BWA_DENOVO"
    script "../main.nf"
    process "BWA_DENOVO"

    test("BWA_DENOVO - paired end") {

        when {
            params {
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test_sub', single_end: false ],
                    file('${projectDir}/assets/NC_003310_clade_I.fasta', checkIfExists: true),
                    [ file('${moduleTestDir}/test_sub_1.fq.gz', checkIfExists: true),
                      file('${moduleTestDir}/test_sub_2.fq.gz', checkIfExists: true) ]
                ])
                input[1] = true
                """
            }
        }

        then {
            assert process.success
            assert process.out.bam.size() == 1
            assert process.out.bai.size() == 1
            assert process.out.bambai.size() == 1
            assert process.out.versions.size() == 1
            assert snapshot(process.out.bam[0][1]).match()
        }

    }
}
