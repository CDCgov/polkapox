nextflow_process {

    name "Test Process AGGREGATE_TSVS"
    script "../main.nf"
    process "AGGREGATE_TSVS"

    test("Aggregate TSV Test") {

        when {
            params {

            }
            process {
                """
                input[0] = Channel.of(
                    file("${moduleTestDir}/test_sub_ivar_summary.txt", checkIfExists: true)
                )
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assert process.out.versions.size() == 1
            assert snapshot(process.out.txt).match()
        }

    }

}
