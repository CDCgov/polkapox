nextflow_process {

    name "Test Process GRAPH_RECON"
    script "../main.nf"
    process "GRAPH_RECON"

    test("Graph Recon Test") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test_sub', single_end: true ],
                    file('${moduleTestDir}/test_sub.bridges_applied.gfa', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert process.out.log.size() == 1
            assert snapshot(
                process.out.gfa_assembly,
                process.out.unicycler_contigs,
                process.out.versions
            ).match()
        }

    }

}
