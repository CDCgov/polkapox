nextflow_process {

    name "Test Process VARIANT_CONVERT"
    script "../main.nf"
    process "VARIANT_CONVERT"

    test("Variant Convert Test") {

        when {
            params {
            }

            process {
                """
                input[0] = Channel.of(
                    [
                        meta: [id: 'test_sub'],
                        tsv: file("${moduleTestDir}/test_sub.ivar.tsv", checkIfExists: true)
                    ]
                )
                input[1] = [af_cutoff: '0.01']
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
